{
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self)"
        },
        {
          "key": "Feature-Policy",
          "value": "microphone 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 30
    },
    "api/admin/[[...path]].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/models/refresh",
      "destination": "/api/admin/models/refresh"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin/[[...path]]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[[...path]]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
