# RailBook — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

RAILWAY_PROVIDER=railcore
RAILCORE_API_KEY=
RAILKIT_API_KEY=
# Round-16o: optional EXTRA fallback APIs (unset = skipped). RailRadar: https://railradar.in/developers (free 1,000 req/month). Indian Rail API: https://indianrailapi.com (signup key).
RAILRADAR_API_KEY=
INDIANRAILAPI_KEY=
RAILWAY_API_BASE_URL=
RAILWAY_API_KEY=
RAILWAY_API_SECRET=
WALLET_INITIAL_BALANCE=10000
SERVICE_FEE_INR=50
MOCK_FORCE_FAIL=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/muse-glimmer-30b
NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b
AI_REQUEST_TIMEOUT_MS=7000

# Round-18g: Muse-glimmer (primary) needs 20-35s per tool round on NIM — give it real time.
AI_AGENTIC_TURN_BUDGET_MS=120000
AI_AGENTIC_TIMEOUT_MS=40000
AI_PRIMARY_MIN_MS=25000
