# RailBook — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

RAILWAY_PROVIDER=railcore
RAILCORE_API_KEY=
RAILKIT_API_KEY=
RAILWAY_API_BASE_URL=
RAILWAY_API_KEY=
RAILWAY_API_SECRET=
WALLET_INITIAL_BALANCE=10000
SERVICE_FEE_INR=50
MOCK_FORCE_FAIL=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
AI_REQUEST_TIMEOUT_MS=7000
