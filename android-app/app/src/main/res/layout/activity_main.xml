<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate">

    <!-- Round-28 (user screenshot 2: "yeh jo upar blue colour mein header hai wo user ko na dikhe,
         backend pe rakho" + screenshot 1: "yeh black wala handoff details user ko nahi dikhni chahiye"):
         poora header (version / Bhasha / status / safety hint / RAILBOOK-IRCTC-CLEAR buttons) screen se
         hata diya (visibility=gone) — par code, buttons aur status logic waisa hi hai (backend me zinda).
         User-facing updates ab chhote Toast se aate hain (dekho noticeToast()), taaki asli UI (RailBook
         web app + IRCTC) hi dikhe, koi permanent bar nahi. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/navy"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_version"
                android:textColor="#93C5FD"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLang"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/btn_lang_default"
                android:textColor="#FDE68A"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_idle"
            android:textColor="#Dbeafe"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/hint_safety"
            android:textColor="#93C5FD"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRailbook"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_railbook"
                android:textColor="@android:color/white"
                app:strokeColor="#93C5FD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrctc"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_irctc"
                android:textColor="@android:color/white"
                app:strokeColor="#93C5FD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_clear"
                android:textColor="#FCA5A5" />
        </LinearLayout>
    </LinearLayout>

    <!-- Round-53 (user: *"meri railbook app mein back button nahi hai … ek baar IRCTC pe autofill hogya to
         reopen pe bhi RailBook directly IRCTC se open hoti hai, not from starting"*): ek patli si nav bar
         (48dp) — ‹ Back · ⌂ RailBook home · ⟳ Reload. Baaki purana header (version/bhasha/status) hidden hi
         rehta hai; ye bar sirf navigation ke liye hai, koi bhaari panel nahi. -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/navy"
        android:elevation="6dp"
        android:paddingHorizontal="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="42dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_home"
                android:src="@android:drawable/ic_menu_view"
                app:tint="#93C5FD" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/navWhere"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93C5FD"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_reload"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/navBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- v1.2.4 PREWARM overlay (Round-22, 26 Sep: user — "usmein sirf likho redirecting to IRCTC
         and time") : ab sirf title ("Redirecting to IRCTC…") + 45s countdown. Step-by-step lines
         hata di gayi (progress ab status bar me). Countdown khatam / login-reached → overlay hat jata hai. -->
    <LinearLayout
        android:id="@+id/prewarmOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@color/navy"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/prewarmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prewarm_title"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="17sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/prewarmCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#93C5FD"
            android:textStyle="bold"
            android:textSize="44sp" />

        <!-- Round-28 (user: "sath mein user ko inform kro ki apki details automatically fill ho jayengi
             IRCTC pe, dubara dalne ki zarort nhi hai"): overlay par ye ek saaf line. -->
        <TextView
            android:id="@+id/prewarmNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/prewarm_note"
            android:textColor="#BBF7D0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center" />

        <!-- Round-22: user ne kaha "sirf redirecting + time" — steps view hidden (code waisa hi: lines
             likhi jaati hain to status bar me dikh sakti hain, screen par shor nahi). -->
        <TextView
            android:id="@+id/prewarmSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#DBEAFE"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"
            android:gravity="center_horizontal" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
